# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
/.widget_preview/

# ── PCHAT: build outputs ─────────────────────────────────────────────────
# These are produced by the build, not part of the source. The canonical
# copies of the release notes and of the Windows build script live in
# `tool/`, so nothing is lost by leaving `dist/` out of the repository.
#
#     dist/  — the packed .apk, the Linux installer, the Windows zip
#     apps/  — the packed .apk and the Arch bundle, copied out for sharing
/dist/
/apps/
*.apk
*.aab
*.run

# ── PCHAT: generated by "flutter pub get" and the desktop tooling ─────────
# The Linux/Windows/macOS/iOS runners each keep an `ephemeral` folder that
# the Flutter tool rewrites on every run.
**/flutter/ephemeral/

# ── Secrets (none of these belong in the repository) ─────────────────────
*.jks
*.keystore
/android/key.properties
.env
.env.*

# The CI build log, which the workflow pushes to the `ci-logs` branch when a
# build fails. The `*.log` rule above would keep it out of the commit.
!ci-logs/*.log
